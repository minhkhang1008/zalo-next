{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/codex.sh *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo build *)",
      "Bash(rustfmt *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)"
    ],
    "deny": [
      "Read(./session.json)",
      "Read(./session*.json)",
      "Read(./accounts/**)",
      "Read(./ai_secret.json)",
      "Read(./sync_identity.json)",
      "Read(./sync_rsa_identity.json)",
      "Read(./sync_v2_keys.json)",
      "Read(./*.db)",
      "Read(~/Library/Application Support/ctdozlite/session.json)",
      "Read(~/Library/Application Support/ctdozlite/accounts/**)",
      "Read(~/Library/Application Support/ctdozlite/ai_secret.json)",
      "Read(~/Library/Application Support/ctdozlite/sync_identity.json)",
      "Read(~/Library/Application Support/ctdozlite/sync_rsa_identity.json)",
      "Read(~/Library/Application Support/ctdozlite/*.db)"
    ]
  }
}
